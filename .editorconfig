# EditorConfig — https://editorconfig.org
# Read automatically by VS Code, Neovim, JetBrains, Sublime, etc.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts: 4 spaces is the more common convention.
[*.sh]
indent_size = 4

# Markdown: trailing whitespace is significant (= line break).
[*.md]
trim_trailing_whitespace = false

# Makefiles require literal tabs.
[Makefile]
indent_style = tab
