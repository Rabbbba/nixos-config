// =============================================================================
// Rofi theme — Gruvbox dark
// Used by: app launcher (drun mode)
// =============================================================================

// --- Color palette (Gruvbox dark) --------------------------------------------
* {
    bg:      #1d2021;   // Darkest background (window base)
    bg1:     #282828;   // Dark background (input bar)
    bg2:     #3c3836;   // Medium background (selected item)
    bg3:     #504945;   // Light background (borders, hover)
    fg:      #ebdbb2;   // Primary foreground text
    fg2:     #a89984;   // Muted foreground (placeholder, secondary)
    yellow:  #d79921;   // Accent — selected item text
    aqua:    #689d6a;   // Accent — prompt icon
    red:     #cc241d;   // Unused here, reserved

    background-color: transparent;
    text-color:       @fg;
    border-color:     @bg3;
}

// --- Window ------------------------------------------------------------------
window {
    background-color: @bg;
    border:           1px;
    border-color:     @bg3;
    border-radius:    12px;
    width:            480px;
    padding:          0;
}

// --- Main container ----------------------------------------------------------
mainbox {
    background-color: transparent;
    padding:          8px;
    spacing:          6px;
}

// --- Search input bar --------------------------------------------------------
inputbar {
    background-color: @bg1;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

// Prompt icon (Nerd Font glyph defined in config.rasi)
prompt {
    color: @aqua;
    font:  "JetBrainsMono Nerd Font 13";
}

// Text input field
entry {
    color:             @fg;
    font:              "JetBrainsMono Nerd Font 13";
    placeholder:       "Rechercher...";
    placeholder-color: @fg2;
}

// --- Results list ------------------------------------------------------------
listview {
    background-color: transparent;
    lines:            8;      // Max visible items
    columns:          1;
    spacing:          2px;
    padding:          4px 0;
}

// Individual result item
element {
    background-color: transparent;
    border-radius:    6px;
    padding:          6px 10px;
    spacing:          10px;
    orientation:      horizontal;
}

// Highlighted (selected) item
element selected {
    background-color: @bg2;
    text-color:       @yellow;
}

// App icon
element-icon {
    size:           24px;
    vertical-align: 0.5;
}

// App name text
element-text {
    color:          @fg;
    font:           "JetBrainsMono Nerd Font 13";
    vertical-align: 0.5;
}

// Text color override for selected item
element selected element-text {
    color: @yellow;
}
