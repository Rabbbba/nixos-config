// =============================================================================
// Rofi main configuration
// Mode: drun (application launcher)
// Theme: see theme.rasi (Gruvbox dark)
// =============================================================================

configuration {
    modi:                "drun";            // Only show app launcher mode
    show-icons:          true;              // Show app icons in the list
    drun-display-format: "{name}";          // Show app name only (no comment/exec)
    disable-history:     false;             // Remember recently launched apps
    hide-scrollbar:      true;              // Hide the scrollbar for cleaner look
    display-drun:        "";               // Icon shown in the prompt (Nerd Font)
}

// Load the visual theme
@theme "~/.config/rofi/theme.rasi"
