// =============================================================================
// Waybar configuration
// Bar on DP-2 (primary ultrawide monitor) only
// Theme: Gruvbox dark (see style.css)
// =============================================================================
[
  {
    "layer": "top", // Render above windows
    "output": "DP-2", // Only show on the primary ultrawide monitor
    "position": "top",
    "height": 56, // Bar height in px (sized for 3440x1440)

    // Left: tag buttons + app launchers
    "modules-left": ["dwl/tags", "custom/discord", "custom/steam"],

    // Center: clock
    "modules-center": ["clock"],

    // Right: media, audio, network, weather, layout, hardware stats, notifications, tray
    "modules-right": [
      "custom/media-prev",
      "custom/media",
      "custom/media-next",
      "pulseaudio",
      "network",
      "custom/weather",
      "custom/gpu",
      "cpu",
      "memory",
      "custom/swaync",
      "tray",
    ],

    // --- Mango tags -------------------------------------------------------
    "dwl/tags": {
      "num-tags": 9,
      "disable-click": false,
    },

    // --- System tray -----------------------------------------------------
    "tray": {
      "spacing": 8, // Pixel gap between tray icons
    },

    // --- Clock -----------------------------------------------------------
    "clock": {
      "format": "{:%H:%M  %d/%m}",
      "tooltip-format": "{:%A %d %B %Y}",
    },

    // --- CPU usage -------------------------------------------------------
    "cpu": {
      "format": "󰻠 {usage}%",
      "interval": 2, // Update every 2 seconds
    },

    // --- RAM usage -------------------------------------------------------
    "memory": {
      "format": "󰍛 {}%",
      "interval": 2,
    },

    // --- Network ---------------------------------------------------------
    "network": {
      "format-wifi": "󰤨 {signalStrength}%",
      "format-disconnected": "󰤭",
      "interval": 2,
    },

    // --- Audio (PulseAudio/Pipewire) -------------------------------------
    "pulseaudio": {
      "format": " {volume}%",
      "format-muted": "󰝟 Mute",
      "on-click": "pavucontrol", // Open mixer on click
    },

    // --- Media controls (Tidal HiFi preferred, fallback to any player) ---
    "custom/media-prev": {
      "format": "󰒮",
      "on-click": "playerctl -p tidal-hifi previous 2>/dev/null || playerctl previous",
      "tooltip": false,
    },

    // Media info: artist - title, with album art tooltip
    // Script: ~/.config/waybar/scripts/media.sh
    "custom/media": {
      "format": "{}",
      "interval": 2,
      "exec": "~/.config/waybar/scripts/media.sh",
      "return-type": "json",
      "on-click": "playerctl -p tidal-hifi play-pause 2>/dev/null || playerctl play-pause",
      "on-click-right": "playerctl -p tidal-hifi play-pause",
    },

    "custom/media-next": {
      "format": "󰒭",
      "on-click": "playerctl -p tidal-hifi next 2>/dev/null || playerctl next",
      "tooltip": false,
    },

    // --- GPU usage (AMD RX 9070 XT) --------------------------------------
    // Reads from sysfs — works on AMD with amdgpu driver
    "custom/gpu": {
      "format": "󰍹 {}%",
      "interval": 2,
      "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
    },

    // --- Weather (wttr.in, updates every 30 min) -------------------------
    // Script: ~/.config/waybar/scripts/weather.sh
    "custom/weather": {
      "format": "{}",
      "interval": 1800,
      "exec": "~/.config/waybar/scripts/weather.sh",
      "return-type": "json",
      "tooltip": true,
    },

    // --- App launchers ---------------------------------------------------
    "custom/discord": {
      "format": "󰙯",
      "on-click": "discord",
      "tooltip": false,
    },

    "custom/steam": {
      "format": "",
      "on-click": "steam",
      "tooltip": false,
    },

    // --- SwayNC notification center --------------------------------------
    // Left click: toggle panel | Right click: toggle DND
    "custom/swaync": {
      "format": "󰂚 {}",
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
    },
  },
]
