#!/usr/bin/env bash
# Pre-commit hook: vérifie la doc Doxygen (si .qml staged) ET le formatage
# Lua via stylua (si .lua staged). Strict mode actif → bloque le commit si
# l'un des deux échoue.
#
# Activation (une fois par clone):
#   git config core.hooksPath .githooks
#
# Skip ponctuel (debug):
#   git commit --no-verify

set -e

repo_root="$(git rev-parse --show-toplevel)"
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

# ── Doxygen check (si du QML est staged) ───────────────────────────────────
if echo "$staged_files" | grep -qE '^quickshell/.*\.qml$'; then
    if command -v doxygen >/dev/null 2>&1; then
        echo "[pre-commit] Quickshell QML modifies, verification de la doc Doxygen..."
        if ! (cd "$repo_root/quickshell" && doxygen Doxyfile >/dev/null 2>&1); then
            echo "[pre-commit] FAIL doxygen — relance manuellement pour voir:" >&2
            echo "             cd quickshell && doxygen Doxyfile" >&2
            exit 1
        fi
        echo "[pre-commit] doxygen OK"
    else
        echo "[pre-commit] doxygen pas dans le PATH — skip (rebuild avec 'nh os switch')" >&2
    fi
fi

# ── stylua check (si du Lua est staged) ────────────────────────────────────
if echo "$staged_files" | grep -qE '\.lua$'; then
    if command -v stylua >/dev/null 2>&1; then
        echo "[pre-commit] Lua modifie, verification du formatage stylua..."
        if ! (cd "$repo_root" && stylua --check nvim/ >/dev/null 2>&1); then
            echo "[pre-commit] FAIL stylua — auto-fix possible:" >&2
            echo "             stylua nvim/" >&2
            exit 1
        fi
        echo "[pre-commit] stylua OK"
    else
        echo "[pre-commit] stylua pas dans le PATH — skip (rebuild avec 'nh os switch')" >&2
    fi
fi
