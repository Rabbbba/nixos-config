{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "output": "DP-2",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 40,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 300,
  "control-center-height": 200,
  "notification-window-width": 300,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "Aucune notification",
  "script-fail-notify": true,
  "widgets": ["mpris"],
  "widget-config": {
    "mpris": {
      "blacklist": ["chromium"],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false,
      "preferred-players": ["tidal-hifi"]
    },
    "volume": {
      "label": "󰕾"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Tout effacer"
    },
    "dnd": {
      "text": "Ne pas déranger"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
