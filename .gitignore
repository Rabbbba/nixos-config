# pi-coding-agent sandbox placeholders — stubs vides + read-only créés
# en pré-seed des paths sensibles (bwrap a besoin que le target existe
# pour `--ro-bind /dev/null target`). Inoffensifs, juste à exclure du
# worktree pour ne pas polluer l'arbre.
# Pas de `/` initial : les ghost files apparaissent dans le CWD de pi
# (racine ou sous-dossier comme `quickshell/`).
.bash_profile
.bashrc
.env
.gitconfig
.gitmodules
.idea
.mcp.json
.profile
.ripgreprc
.vscode
.zprofile
.zshrc

# Faux dossier `~` créé par un script qui a dû faire `mkdir ~` au lieu de `$HOME`.
~/

# Generated by cachix/pre-commit-hooks.nix; contains machine-specific /nix/store paths.
.pre-commit-config.yaml

